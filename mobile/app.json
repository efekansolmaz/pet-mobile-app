{
  "expo": {
    "name": "PetCare",
    "slug": "petcare-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "petcare",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.petcare.mobileapp",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "PetCare needs access to your camera to take photos of your pets and medical documents.",
        "NSPhotoLibraryUsageDescription": "PetCare needs access to your photo library to select pet profile pictures and vaccination records."
      }
    },
    "android": {
      "package": "com.petcare.mobileapp",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#1F6F5B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F6F3EE"
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you set pet avatars and upload vaccine cards."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
